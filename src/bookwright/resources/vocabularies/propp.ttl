<https://bookwright.dev/vocab/propp#function/complicity>
    a crm:E55_Type ; rdfs:label "complicity"@en, "complicidad"@es .
<https://bookwright.dev/vocab/propp#function/villainy>
    a crm:E55_Type ; rdfs:label "villainy"@en, "lack"@en, "fechoría"@es, "carencia"@es .
